            "role": "Developer"
        }
    ],
    "keywords": ["aksara","aksaracms","aksara cms","headless cms","restful","api","codeigniter","framework","crud","crud generator","ai cms","ai-powered cms","ai","ai assistant","aksara ai","aksara ai assistant"],
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "abydahana/aksara-ai": "^1.0",
        "codeigniter4/framework": "~4.7.0",
        "twig/twig": "^3.7",
        "hybridauth/hybridauth": "^3.10",
        "mpdf/mpdf": "^8.0",
        "chillerlan/php-qrcode": "^3.3",
        "picqer/php-barcode-generator": "^2.1",
        "phpoffice/phpspreadsheet": "^2.2",
        "halaxa/json-machine": "^1.1",
        "phpoffice/phpword": "^1.4",
        "league/flysystem-aws-s3-v3": "^3.35",
        "gasparesganga/php-shapefile": "^3.4",
        "brick/geo": "^0.13.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.14",
        "phpstan/phpdoc-parser": "^1.16"
    },
    "scripts": {
        "cs-fix": [
            "node bin/js-build.js",
            "php-cs-fixer fix --ansi",
            "php-cs-fixer fix --config=.php-cs-fixer-views.php --ansi"
        ]
    },
    "scripts-descriptions": {
        "cs-fix": "Fixing the coding style for PHP files, views, and assets"
    }
